<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventory_Mangement_System.CategoryPage">
    
    <Grid ColumnDefinitions="180,*">

        <!-- Sidebar -->
        <VerticalStackLayout Grid.Column="0"
                   Padding="15">

            <Label Text="Inventory"
         FontSize="24"
         FontAttributes="Bold"
                    Padding="15"/>

            <Button Text="Dashboard" BackgroundColor="AliceBlue" TextColor="Black" Clicked="DashBoard_Clicked"/>
            <Button Text="Products" BackgroundColor="AliceBlue" TextColor="Black" Clicked="Products_Clicked"/>
            <Button Text="Categories" BackgroundColor="AliceBlue" TextColor="Black" Clicked="Categories_Clicked"/>

        </VerticalStackLayout>

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="30"
                                 Spacing="20">
                <Label Text="Category Page"
                        FontSize="32"
                        FontAttributes="Bold"/>

            </VerticalStackLayout>
        </ScrollView>


    </Grid>

</ContentPage>