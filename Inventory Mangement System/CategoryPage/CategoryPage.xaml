<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventory_Mangement_System.CategoryPage">

    <Grid ColumnDefinitions="Auto,*"
          x:Name="RootLayout"
          SizeChanged="RootLayout_SizeChanged">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SidebarStates">
                <VisualState x:Name="Desktop">
                    <VisualState.Setters>
                        <Setter Property="IsVisible" Value="True" TargetName="Sidebar"/>

                        <Setter Property="IsVisible" Value="False" TargetName="MenuButton"/>

                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Mobile">
                    <VisualState.Setters>

                        <Setter Property="IsVisible" Value="True" TargetName="MenuButton"/>

                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <!-- Sidebar -->
        <VerticalStackLayout Grid.Column="0"
                             Padding="15"
                             BackgroundColor="WhiteSmoke"
                             x:Name="Sidebar"
                             ZIndex = "10"
                             HorizontalOptions="Start"
                             IsVisible="False"
                             WidthRequest="200">

            <Label Text="Inventory"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="15"/>

            <HorizontalStackLayout>
                <Image Source="home.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Dashboard"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            Clicked="DashBoard_Clicked"/>

            </HorizontalStackLayout>



                <HorizontalStackLayout>

                    <Image Source="product.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                    <Button Text="Products"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="Products_Clicked"/>

                </HorizontalStackLayout>



            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="LightGray"
                    Padding="5">
                
            <HorizontalStackLayout>
                <Image Source="category.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Categories"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="Categories_Clicked"/>
            </HorizontalStackLayout>

            </Border>
        </VerticalStackLayout>


        <!-- Category Page Content -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="20"
              Padding="30">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">

            <!-- Page Title -->
            <Label Text="Categories"
                   FontSize="32"
                   FontAttributes="Bold"
                   Grid.Column="0"/>

            <!-- hamburger button for mobile -->
            <Button x:Name="MenuButton"
                            Text="☰"
                            FontSize="28"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            IsVisible="False"
                            HorizontalOptions="End"
                            Grid.Column="1"
                            Clicked="HamburgerButton_Clicked"/>

            </Grid>

            <HorizontalStackLayout  x:Name="CategoryActionsLayout"
                                    Grid.Row="1"
                                    Spacing="140"> 
                
                <Button Text="Add Category"
                        HorizontalOptions="Start"
                        BackgroundColor="Orange"
                        FontAttributes="Bold"
                        FontSize="12"
                        TextColor="Black"
                        Clicked="AddCategory_Clicked"/>
                
                <SearchBar x:Name="CategorySearchBar"
                           Placeholder="Search..."
                           TextChanged="CategorySearchBar_TextChanged"
                           HorizontalOptions="End"
                           WidthRequest="200"/>
                
            </HorizontalStackLayout>
         


            <Border x:Name="CategoryBorder"
                    Grid.Row="2"
                    WidthRequest="450"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Stroke="#D1D1D1"
                    StrokeThickness="1"
                    Padding="0">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="10">

                    
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          Padding="15"
                          BackgroundColor="#F0F0F0">

                        <Label Text="Name"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                        <Label Text="Actions"
                               Grid.Column="1"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                    </Grid>

                    <!-- Category List -->
                    <CollectionView x:Name="CategoryCollection"
                                    Grid.Row="1"
                                    VerticalOptions="Start">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="15">

                                    <Label Text="{Binding CategoryName}"
                                           Grid.Column="0"
                                           VerticalOptions="Center"/>
                                    <HorizontalStackLayout Grid.Column="1">
                                        <Button  BackgroundColor="White"
                                                 ImageSource="edit.png"
                                                 HeightRequest="25"
                                                 WidthRequest="25"
                                                 Padding="5"
                                                 Clicked="EditCategory_Clicked"
                                                 CommandParameter="{Binding .}"/>

                                        <Button BackgroundColor="White"
                                                ImageSource="delete.png"
                                                HeightRequest="25"
                                                WidthRequest="25"
                                                Padding="5"
                                                Clicked="DeleteCategory_Clicked"
                                                CommandParameter="{Binding .}"/>
                                        
                                    </HorizontalStackLayout>
                                    

                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>