<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventory_Mangement_System.MainPage">

    <Grid ColumnDefinitions="180,*">

        <!-- Sidebar -->
        <VerticalStackLayout Grid.Column="0"
                             Padding="15"
                             BackgroundColor="WhiteSmoke">

            <Label Text="Inventory"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="15"/>

            <Button Text="Dashboard"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    Clicked="DashBoard_Clicked"/>

            <Button Text="Products"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    Clicked="Products_Clicked"/>

            <Button Text="Categories"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    Clicked="Categories_Clicked"/>

        </VerticalStackLayout>

        <!-- Main content -->
        <ScrollView Grid.Column="1">

            <VerticalStackLayout Padding="30"
                                 Spacing="20">

                <Label Text="Dashboard"
                       FontSize="32"
                       FontAttributes="Bold"/>

                <!-- Dashboard cards -->
                <HorizontalStackLayout Spacing="20">

                    <Border Padding="20">
                        <VerticalStackLayout>
                            <Label Text="Products"/>
                            <Label x:Name="ProductsCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="20">
                        <VerticalStackLayout>
                            <Label Text="Low Stock"/>
                            <Label x:Name="LowCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="20">
                        <VerticalStackLayout>
                            <Label Text="Categories"/>
                            <Label x:Name="CategoriesCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>

                </HorizontalStackLayout>

                <!-- Recent Activity -->
                <Label Text="Recent Activity"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <Border Padding="15" 
                        WidthRequest="600"
                        HeightRequest="300"
                        HorizontalOptions="Start" >
                    <CollectionView x:Name="RecentActivitiesView"
                                    HeightRequest="300"
                                    SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="5"
                                                     Padding="5">

                                    <Label Text="{Binding ChangeReason}"
                                           FontAttributes="Bold"
                                           FontSize="16"/>

                                    <Label Text="{Binding Description}"
                                           LineBreakMode="WordWrap"/>

                                    <Label Text="{Binding Time,
                                                          StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </Border>

                <!-- Quick Actions -->
                <Label Text="Quick Actions"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Add product"
                            TextColor="Black"
                            BackgroundColor="Orange"
                            Clicked="AddProduct_Clicked"/>

                    <Button Text="Add Category"
                            TextColor="Black"
                            BackgroundColor="Orange"
                            Clicked="AddCategory_Clicked"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
