<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventory_Mangement_System.MainPage">

    <Grid ColumnDefinitions="Auto,*"
          x:Name="RootLayout" 
          SizeChanged="RootLayout_SizeChanged">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SidebarStates">
                <VisualState x:Name="Desktop">
                    <VisualState.Setters>
                        <Setter Property="IsVisible" Value="True" TargetName="Sidebar"/>
                        
                        <Setter Property="IsVisible" Value="False" TargetName="MenuButton"/>

                        <Setter Property="WidthRequest" Value="500" TargetName="RecentActivitiesBorder"/>



                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Mobile">
                    <VisualState.Setters>

                        <Setter Property="IsVisible" Value="True" TargetName="MenuButton"/>

                        <Setter Property="WidthRequest" Value="300" TargetName="RecentActivitiesBorder"/>



                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Sidebar -->
        <VerticalStackLayout Grid.Column="0"
                             Padding="15"
                             BackgroundColor="WhiteSmoke"
                             x:Name="Sidebar"
                             ZIndex = "10"
                             HorizontalOptions="Start"
                             IsVisible="False"
                             WidthRequest="200">


            <Label Text="Inventory"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="15"/>

            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="LightGray"
                    Padding="5">

                <HorizontalStackLayout>
                    <Image Source="home.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                    <Button Text="Dashboard"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="DashBoard_Clicked"/>

                </HorizontalStackLayout>
            </Border>

            <HorizontalStackLayout>
                <Image Source="product.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Products"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="Products_Clicked"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Image Source="category.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Categories"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    Clicked="Categories_Clicked"/>
            </HorizontalStackLayout>


        </VerticalStackLayout>

        
        
        <!-- Main content -->
        <ScrollView Grid.Column="1">

            <VerticalStackLayout Padding="30"
                                 Spacing="20">
                <Grid ColumnDefinitions="*,Auto">


                    <Label Text="Dashboard"
                           FontSize="32"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Grid.Column="0"/>

                    <!-- hamburger button for mobile -->
                    <Button x:Name="MenuButton"
                            Text="☰"
                            FontSize="28"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            IsVisible="False"
                            HorizontalOptions="End"
                            Grid.Column="1"
                            Clicked="HamburgerButton_Clicked"/>

                </Grid>
                

                <!-- Dashboard cards -->
                <Grid  RowDefinitions="Auto, Auto"
                       ColumnDefinitions="Auto,Auto,Auto,Auto"
                       ColumnSpacing="10"
                       RowSpacing="10">
                    
                    <Border Padding="10" 
                            WidthRequest="90" 
                            Grid.Column="0">
                        
                        <VerticalStackLayout >
                            <Label Text="Products" 
                                   x:Name="ProductsLabel"/>
                            <Label x:Name="ProductsCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="10" 
                            WidthRequest="90" 
                            Grid.Column="1">
                        
                        <VerticalStackLayout>
                            <Label Text="Categories"
                                   x:Name="CategoriesLabel"/>
                            <Label x:Name="CategoriesCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>




                    <Border Padding="10" 
                            WidthRequest="90" 
                            Grid.Column="2"
                            x:Name="LowStockCountBorder">
                        
                        <VerticalStackLayout>
                            <Label Text="Low Stock"
                                   x:Name="LowStockLabel"/>
                            <Label x:Name="LowCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="10" 
                            WidthRequest="90" 
                            Grid.Column="3"
                            x:Name="OutOfStockCountBorder">
                        
                        <VerticalStackLayout>
                            <Label Text="Out Of Stock"
                                   x:Name="OutOfStockLabel"/>
                            <Label x:Name="OutOfStockCount"
                                   Text="0"
                                   FontSize="28"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid
                            >

                <!-- Recent Activity -->
                <Label Text="Recent Activity"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <Border x:Name="RecentActivitiesBorder"
                        Padding="15" 
                        WidthRequest="500"
                        HeightRequest="300"
                        HorizontalOptions="Start" >
                    <CollectionView x:Name="RecentActivitiesView"
                                    HeightRequest="300"
                                    SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="5"
                                                     Padding="5">

                                    <Label Text="{Binding ChangeReason}"
                                           FontAttributes="Bold"
                                           FontSize="16"/>

                                    <Label Text="{Binding Description}"
                                           LineBreakMode="WordWrap"/>

                                    <Label Text="{Binding Time,
                                                          StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </Border>

                <!-- Quick Actions -->
                <Label Text="Quick Actions"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Add product"
                            TextColor="Black"
                            BackgroundColor="Orange"
                            Clicked="AddProduct_Clicked"/>

                    <Button Text="Add Category"
                            TextColor="Black"
                            BackgroundColor="Orange"
                            Clicked="AddCategory_Clicked"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
