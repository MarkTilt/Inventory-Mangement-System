<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Inventory_Mangement_System.AddProductPopupPage">


    <VerticalStackLayout Spacing="10" >
        <!-- Title -->
        <Label Text="Adding Product" FontSize="20" FontAttributes="Bold" Padding="2"/>




        <Grid ColumnDefinitions="*, Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="10">

            <!-- Labels -->
            <Label Text="Name:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Category:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Price:" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Quantity:" Grid.Row="3" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Low Stock Threshold:" Grid.Row="4" Grid.Column="0" VerticalOptions="Center"/>


            <!-- Editable product values -->
            <Entry x:Name="ProductName"  Grid.Row="0" Grid.Column="1" Placeholder="Enter Name"/>
            <Picker x:Name="ProductCategory" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding CategoryName}" 
                    SelectedItem="{Binding ProdctCategory, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" Title="Select Category"/>
            <Entry x:Name="ProductPrice"  Grid.Row="2" Grid.Column="1" Keyboard="Numeric" Placeholder="Enter Price"/>
            <Entry x:Name="ProductQauntity" Grid.Row="3" Grid.Column="1" Keyboard="Numeric" Placeholder="Enter Amount"/>
            <Entry x:Name="ProductLowStockThreshold" Grid.Row="4" Grid.Column="1" Keyboard="Numeric" Placeholder="Enter Amount"/>


        </Grid>
        <Button Text="Add" BackgroundColor="Orange" TextColor="White" FontAttributes="Bold" FontSize="20"  Clicked="AddOn_Clicked"/>
        <Button Text="Cancel" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold" FontSize="20"  Clicked="CancelOn_Clicked"/>
    </VerticalStackLayout>


</toolkit:Popup>


