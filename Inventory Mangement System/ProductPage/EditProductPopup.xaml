<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Inventory_Mangement_System.EditProductPopup">


    <VerticalStackLayout Spacing="10">
        <!-- Title -->
        <Label Text="{Binding Product.ProductName, StringFormat= 'Editing Product: {0}'}" FontSize="20" FontAttributes="Bold" Padding="2"/>




        <Grid ColumnDefinitions="*, Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto"
              ColumnSpacing="12"
              RowSpacing="10">

            <!-- Image -->
            <Border Stroke="Gray" Grid.Row="0" Grid.Column="0" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start" >
                <Image x:Name="ProductImage" Source="{Binding Product.ImagePath}"   HeightRequest="100" WidthRequest="100" Aspect="AspectFit"/>
            </Border>

            <!-- Labels -->
            <Label Text="Name:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
            <Label Text="Category:" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Price:" Grid.Row="3" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Quantity:" Grid.Row="4" Grid.Column="0" VerticalOptions="Center"/>
            <Label Text="Low Stock Threshold:" Grid.Row="5" Grid.Column="0" VerticalOptions="Center"/>
         

            <!-- Editable product values -->
            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="10">
                <Button Text="Edit Image" Clicked="EditImage_Clicked" BackgroundColor="Orange" HeightRequest="40"/>
                <Button Text="Remove Image" Clicked="ResetImage_Clicked" BackgroundColor="Gray" HeightRequest="40"/>
            </VerticalStackLayout>
            <Entry Text="{Binding EditedName, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" />
            <Picker ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding CategoryName}" 
                    SelectedItem="{Binding EditedCategory, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" />
            <Entry Text="{Binding EditedPrice, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" Keyboard="Numeric"/>
            <Entry Text="{Binding EditedQuantity, Mode=TwoWay}" Grid.Row="4" Grid.Column="1" Keyboard="Numeric"/>
            <Entry Text="{Binding EditedLowStockThreshold, Mode=TwoWay}" Grid.Row="5" Grid.Column="1" Keyboard="Numeric"/>
            

        </Grid>
        <Button Text="Save" BackgroundColor="Orange" TextColor="White" FontAttributes="Bold" FontSize="20"  Clicked="SaveOn_Clicked"/>
        <Button Text="Cancel" BackgroundColor="Gray" TextColor="White" FontAttributes="Bold" FontSize="20"  Clicked="CancelOn_Clicked"/>
    </VerticalStackLayout>
  
    
</toolkit:Popup>