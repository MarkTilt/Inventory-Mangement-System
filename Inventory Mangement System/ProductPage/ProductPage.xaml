<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventory_Mangement_System.ProductPage">

    <Grid ColumnDefinitions="180,*">

        <!-- Sidebar -->
        <VerticalStackLayout Grid.Column="0"
                             Padding="15"
                             BackgroundColor="WhiteSmoke">

            <Label Text="Inventory"
                   FontSize="24"
                   FontAttributes="Bold"
                   Padding="15"/>

            

                <HorizontalStackLayout>
                    <Image Source="home.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                    <Button Text="Dashboard"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            Clicked="DashBoard_Clicked"/>

                </HorizontalStackLayout>
          
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Stroke="LightGray"
                    Padding="5">
                
                <HorizontalStackLayout>
                    
                <Image Source="product.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Products"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="Products_Clicked"/>
                    
            </HorizontalStackLayout>
                
            </Border>
            
            
            <HorizontalStackLayout>
                <Image Source="category.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30"/>
                <Button Text="Categories"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Clicked="Categories_Clicked"/>
            </HorizontalStackLayout>
            
        </VerticalStackLayout>

        <!-- Product Page -->
        <Grid Grid.Column="1"
              Padding="30"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="20">

            <!-- Page Heading -->
            <Label Text="Products"
                   FontSize="32"
                   FontAttributes="Bold"
                   Grid.Row="0"/>

            <!-- Add Product and Search -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,200,200"
                  ColumnSpacing="10">

                <Button Text="Add Product"
                        Grid.Column="0"
                        BackgroundColor="Orange"
                        FontAttributes="Bold"
                        FontSize="12"
                        TextColor="Black"
                        Clicked="AddProduct_Clicked"/>

                <SearchBar x:Name="ProductSearchBar"
                           Grid.Column="3"
                           Placeholder="Search"
                           TextChanged="ProductSearchBar_TextChanged"/>

                <Picker x:Name="StatusFilter"
                        Title="Filter by Status"
                        Grid.Column="2"
                        SelectedIndexChanged="FilterOn_Changed"/>
            </Grid>


            <Border Grid.Row="2"
                    Padding="10"
                    BackgroundColor="#F0F0F0"/>

            <!-- Scrollable Product List -->
            <CollectionView x:Name="ProductsCollection"
                            Grid.Row="3"
                            VerticalScrollBarVisibility="Always">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="0"
                                Margin="0,0,0,5">

                            <Grid ColumnDefinitions="Auto,Auto,Auto, *"
                                  RowDefinitions="*,Auto,Auto,Auto,Auto,*"
                                  Padding="10"
                                  ColumnSpacing="5"
                                  >
                                
                                <Border Grid.Column="0" WidthRequest="120" HeightRequest="120" Stroke="Gray" Grid.RowSpan="6">
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                </Border>

                                <Label Text="{Binding ProductName }"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       VerticalOptions="Center"
                                       FontAttributes="Bold"
                                       FontSize="18"/>

                                <Label Text="{Binding Category.CategoryName}"
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding Price, StringFormat='R{0:F2}'}"
                                       Grid.Column="1"
                                       Grid.Row="3"
                                       VerticalOptions="Center"/>
                                

                                <Label Text="{Binding Quantity, StringFormat='- {0} Units'}"
                                       Grid.Column="2"
                                       Grid.Row="3"
                                       VerticalOptions="Center"
                                        HorizontalOptions="Start"/>

                                <Label Text="{Binding LowStockThreshold, StringFormat='Low Stock Threshold: {0}'}"
                                       Grid.Column="2"
                                       Grid.Row="5"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start"
                                       FontSize="11"/>

                                <Label Text="{Binding Status}"
                                       Grid.Column="1"
                                       Grid.Row="5"
                                       VerticalOptions="Center">

                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Status}"
                                                     Value="Low Stock">
                                             <Setter Property="TextColor" Value="DarkOrange"/>
                                        </DataTrigger>

                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Status}"
                                                     Value="Out of Stock">
                                             <Setter Property="TextColor" Value="Red"/>
                                        </DataTrigger>

                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Status}"
                                                     Value="In Stock">
                                             <Setter Property="TextColor" Value="Green"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Product Actions -->
                                <Grid Grid.Column="3"
                                      RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,Auto"
                                      Grid.RowSpan="6"
                                      Padding="20"
                                      VerticalOptions="Center"
                                      HorizontalOptions="End">

                                    <Button Text="+"
                                            TextColor="Green"
                                            FontSize="24"
                                            WidthRequest="35"
                                            HeightRequest="40"
                                            Padding="0"
                                            BackgroundColor="White"
                                            Clicked="AddStock_Clicked"
                                            CommandParameter="{Binding .}"
                                            Grid.Column="0"
                                            Grid.Row="0"/>

                                    <Button Text="-"
                                            TextColor="Red"
                                            FontSize="24"
                                            WidthRequest="35"
                                            HeightRequest="40"
                                            Padding="0"
                                            BackgroundColor="White"
                                            Clicked="RemoveStock_Clicked"
                                            CommandParameter="{Binding .}"
                                            Grid.Column="1"
                                            Grid.Row="0"/>

                                    <Button ImageSource="edit.png"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Padding="5"
                                            BackgroundColor="White"
                                            Clicked="EditProduct_Clicked"
                                            CommandParameter="{Binding .}"
                                            Grid.Column="0"
                                            Grid.Row="1"/>

                                    <Button ImageSource="delete.png"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Padding="5"
                                            BackgroundColor="White"
                                            Clicked="DeleteProduct_Clicked"
                                            CommandParameter="{Binding .}"
                                            Grid.Column="1"
                                            Grid.Row="1"/>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>