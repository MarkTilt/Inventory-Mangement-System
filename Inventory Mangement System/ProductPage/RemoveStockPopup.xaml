<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Inventory_Mangement_System.RemoveStockPopup">





    <Grid ColumnDefinitions="*,*"
          RowDefinitions="*,*,*"
          RowSpacing="30" >

        <Label Text="{Binding Product.ProductName, StringFormat= 'Remove Stock from {0}'}" Grid.ColumnSpan="2" FontSize="20" FontAttributes="Bold" />

        <Label Text="Qauntity:" Grid.Column="0" Grid.Row="1" FontSize="15" VerticalOptions="Center"/>
        <Entry x:Name="QauntityToRemove"  Grid.Column="1" Grid.Row="1" Keyboard="Numeric" Placeholder="Enter Amount"/>

        <Button Clicked="Remove_Clicked" Text="Remove" BackgroundColor="Red" TextColor="White" FontSize="18" Grid.Column="0" Grid.Row="2" WidthRequest="100" HeightRequest="50" />
        <Button Clicked="Cancel_Clicked"  Text="Cancel" BackgroundColor="Gray" TextColor="White" FontSize="18" Grid.Column="1" Grid.Row="2" WidthRequest="100" HeightRequest="50"/>

    </Grid>


</toolkit:Popup>